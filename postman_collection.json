    {
      "name": "Product Inventory",
      "item": [
        {
          "name": "List Products",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/products?page=1&limit=10&q=&lowStock=false",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "products"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                },
                {
                  "key": "q",
                  "value": "",
                  "description": "Search keyword matching name or SKU"
                },
                {
                  "key": "lowStock",
                  "value": "false",
                  "description": "Set to true to filter items below minStockAlert quantity"
                }
              ]
            },
            "description": "Get catalog list, highlight low stock. Available to all authenticated roles."
          },
          "response": []
        },
        {
          "name": "Create Product",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Heavy Duty Steel Shelving\",\n  \"sku\": \"SHL-STL-006\",\n  \"category\": \"Warehouse Equipment\",\n  \"unitPrice\": 4500,\n  \"currentStock\": 15,\n  \"minStockAlert\": 5,\n  \"location\": \"Aisle 12, Shelf D\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/products",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "products"
              ]
