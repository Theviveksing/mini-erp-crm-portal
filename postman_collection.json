    {
      "name": "Sales Challans",
      "item": [
        {
          "name": "List Challans",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/challans?page=1&limit=10&status=",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "challans"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                },
                {
                  "key": "status",
                  "value": "",
                  "description": "Filter by DRAFT, CONFIRMED, CANCELLED"
                }
              ]
            },
            "description": "List all business sales challans. Available to all authenticated roles."
          },
          "response": []
        },
        {
          "name": "Get Challan Details",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/challans/1",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "challans",
                "1"
              ]
            },
            "description": "Get single challan record showing details, customer info, and parsed item snapshot array."
          },
          "response": []
        },
        {
          "name": "Create Sales Challan",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": 1,\n  \"items\": [\n    {\n      \"productId\": 1,\n      \"quantity\": 5\n    },\n    {\n      \"productId\": 2,\n      \"quantity\": 10\n    }\n  ],\n  \"status\": \"DRAFT\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/challans",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "challans"
              ]
            },
            "description": "Generate a sales challan. If status is CONFIRMED, database will check product quantities and deduct them. Allowed roles: ADMIN, SALES."
          },
          "response": []
        },
        {
          "name": "Confirm Draft Challan",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/challans/1/confirm",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "challans",
                "1",
                "confirm"
              ]
            },
            "description": "Transition a DRAFT challan to CONFIRMED status, reducing inventory stocks. Allowed roles: ADMIN, SALES."
          },
          "response": []
        },
        {
          "name": "Cancel Challan",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/challans/1/cancel",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "challans",
                "1",
                "cancel"
              ]
            },
            "description": "Cancel a challan. If the challan was CONFIRMED, inventory stock quantities will automatically be returned to products. Allowed roles: ADMIN, SALES."
          },
          "response": []
        }
      ]
    }
